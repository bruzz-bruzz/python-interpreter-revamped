# Files and directories that Vercel should NOT upload to the build
# sandbox. Keeping the upload small speeds up cold-deploys.
#
# IMPORTANT: do NOT ignore `src/` or `examples/`. The frontend bundles
# those `.py` files into the JS bundle at build time via Vite's
# `?raw` import suffix, so they need to be present in the upload.

# Python tests, Python tooling, and the CLI entrypoint are not
# needed by the web build.
tests/
interpreter.py
__pycache__/
*.py[cod]
*.egg-info/

# Frontend build artifacts (rebuilt on Vercel)
web/node_modules/
web/dist/
web/dist-node/
web/*.tsbuildinfo

# Editor / OS noise
.vscode/
.idea/
.DS_Store
*.swp
*.swo

# Git
.git/
