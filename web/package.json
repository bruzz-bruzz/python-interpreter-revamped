{
  "name": "python-interpreter-playground",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Browser-based Python-subset interpreter implemented from scratch in TypeScript (no Pyodide)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "smoke": "tsx scripts/smoke-test.ts",
    "generate-examples": "tsx scripts/generate-examples.ts"
  },
  "dependencies": {
    "@codemirror/lang-python": "^6.1.5",
    "@codemirror/state": "^6.4.1",
    "@codemirror/view": "^6.26.0",
    "@uiw/react-codemirror": "^4.21.25",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.23.13",
    "typescript": "^5.3.3",
    "vite": "^5.0.10"
  }
}
